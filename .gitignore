# === Claude Code Local ===
.claude/settings.local.json
CLAUDE.local.md
project.local.yaml
production/session-logs/
# Ephemeral per-session checkpoint. directory-structure.md documents this as
# gitignored; the rule was missing, so active.md would have been committed.
# The contents are ignored rather than the directory itself: git cannot
# re-include a file whose parent directory is excluded, so only this form lets
# the `.gitkeep` exception below take effect.
production/session-state/*
!production/session-state/.gitkeep
.scratch/
# Per-agent working memory written at runtime — not release material
.claude/agent-memory/

